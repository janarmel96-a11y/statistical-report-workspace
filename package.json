{
  "name": "statistical-report-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based statistical report workspace. Turns Excel, CSV, JSON and PDF files into interactive reports. No login, no server.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare:assets": "node scripts/copy-ocr-assets.mjs",
    "dev": "npm run prepare:assets && vite",
    "build": "npm run prepare:assets && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@tesseract.js-data/eng": "1.0.0",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jszip": "3.10.2",
    "lucide-react": "1.75.0",
    "papaparse": "5.7.1",
    "pdfjs-dist": "6.5.438",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "tesseract.js": "7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-grid-layout": "2.1.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
